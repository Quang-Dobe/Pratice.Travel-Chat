{
  "Kestrel": {
    "Endpoints": {
      "Public": {
        "Url": "http://+:8080"
      },
      "Internal": {
        "Url": "http://+:8081"
      }
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "CallbackPath": "/signin-oidc"
  },
  "InternalToken": {
    "Lifetime": "00:05:00",
    "InternalPort": 8081,
    "InternalBaseUrl": "http://q-gateway:8081"
  },
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "q-user",
        "AuthorizationPolicy": "api",
        "Match": {
          "Path": "/api/users/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" }
        ]
      },
      "conversations": {
        "ClusterId": "q-agent",
        "AuthorizationPolicy": "api",
        "Match": {
          "Path": "/api/conversations/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeaderRemove": "Cookie" }
        ]
      },
      "web": {
        "ClusterId": "web",
        "Order": 10000,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "Cookie" }
        ]
      }
    },
    "Clusters": {
      "q-user": {
        "Destinations": {
          "primary": { "Address": "http://q-user:8080" }
        }
      },
      "q-agent": {
        "Destinations": {
          "primary": { "Address": "http://q-agent:8000" }
        }
      },
      "web": {
        "Destinations": {
          "primary": { "Address": "http://web:80" }
        }
      }
    }
  }
}
